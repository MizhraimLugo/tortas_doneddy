# Copia este archivo como `.env.local` y completa los valores.

# ─────────────────────────────────────────────────────────────────────────────
# OBLIGATORIO ANTES DE PUBLICAR
# ─────────────────────────────────────────────────────────────────────────────
# Dominio real del sitio, sin diagonal al final.
#
# De aquí salen las URLs canónicas, el sitemap, los enlaces de Open Graph y los
# `@id` del JSON-LD. Si se queda con el valor por defecto, esas URLs apuntarán a
# un dominio que no controlas y Google indexará direcciones equivocadas.
NEXT_PUBLIC_SITE_URL=https://tortasdoneddy.mx


# ─────────────────────────────────────────────────────────────────────────────
# OPCIONAL — medición
# ─────────────────────────────────────────────────────────────────────────────
# Identificador de Google Analytics 4 (formato G-XXXXXXXXXX).
#
# El código de seguimiento en `src/lib/analytics.ts` ya está listo: envía un
# evento `generate_lead` cada vez que alguien toca un botón de pedido, con el
# canal (whatsapp, telefono, rappi, uber_eats) y la posición del botón. Solo
# falta cargar el script de GA4 en el layout para que empiece a registrar.
#
# NEXT_PUBLIC_GA_ID=
